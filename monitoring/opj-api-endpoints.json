{
  "uid": "opj-api-endpoints",
  "title": "OPJ API – Endpoints",
  "tags": [
    "opj",
    "rails",
    "http"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Chamadas HTTP por endpoint (período selecionado)",
      "description": "Uma linha por rota (método + controller#action). Latências são estimadas a partir dos buckets do histograma, então valores muito baixos são aproximados. Clique no cabeçalho para ordenar.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 14
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum by (method, controller, action) (increase(rails_requests_total{job=\"opj-api\",controller!=\"rails/health\"}[$__range]))) and on (method, controller, action) (sum by (method, controller, action) (increase(rails_requests_total{job=\"opj-api\",controller!=\"rails/health\"}[$__range])) > 0)",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": ""
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum by (method, controller, action) (increase(rails_request_duration_seconds_sum{job=\"opj-api\",controller!=\"rails/health\"}[$__range])) / sum by (method, controller, action) (increase(rails_request_duration_seconds_count{job=\"opj-api\",controller!=\"rails/health\"}[$__range]))) and on (method, controller, action) (sum by (method, controller, action) (increase(rails_requests_total{job=\"opj-api\",controller!=\"rails/health\"}[$__range])) > 0)",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": ""
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(histogram_quantile(0.5, sum by (le, method, controller, action) (increase(rails_request_duration_seconds_bucket{job=\"opj-api\",controller!=\"rails/health\"}[$__range])))) and on (method, controller, action) (sum by (method, controller, action) (increase(rails_requests_total{job=\"opj-api\",controller!=\"rails/health\"}[$__range])) > 0)",
          "refId": "C",
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": ""
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(histogram_quantile(0.95, sum by (le, method, controller, action) (increase(rails_request_duration_seconds_bucket{job=\"opj-api\",controller!=\"rails/health\"}[$__range])))) and on (method, controller, action) (sum by (method, controller, action) (increase(rails_requests_total{job=\"opj-api\",controller!=\"rails/health\"}[$__range])) > 0)",
          "refId": "D",
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": ""
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(histogram_quantile(0.99, sum by (le, method, controller, action) (increase(rails_request_duration_seconds_bucket{job=\"opj-api\",controller!=\"rails/health\"}[$__range])))) and on (method, controller, action) (sum by (method, controller, action) (increase(rails_requests_total{job=\"opj-api\",controller!=\"rails/health\"}[$__range])) > 0)",
          "refId": "E",
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": ""
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "((sum by (method, controller, action) (increase(rails_requests_total{job=\"opj-api\",controller!=\"rails/health\",status=~\"4..\"}[$__range])) or sum by (method, controller, action) (increase(rails_requests_total{job=\"opj-api\",controller!=\"rails/health\"}[$__range])) * 0) / sum by (method, controller, action) (increase(rails_requests_total{job=\"opj-api\",controller!=\"rails/health\"}[$__range]))) and on (method, controller, action) (sum by (method, controller, action) (increase(rails_requests_total{job=\"opj-api\",controller!=\"rails/health\"}[$__range])) > 0)",
          "refId": "F",
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": ""
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "((sum by (method, controller, action) (increase(rails_requests_total{job=\"opj-api\",controller!=\"rails/health\",status=~\"5..\"}[$__range])) or sum by (method, controller, action) (increase(rails_requests_total{job=\"opj-api\",controller!=\"rails/health\"}[$__range])) * 0) / sum by (method, controller, action) (increase(rails_requests_total{job=\"opj-api\",controller!=\"rails/health\"}[$__range]))) and on (method, controller, action) (sum by (method, controller, action) (increase(rails_requests_total{job=\"opj-api\",controller!=\"rails/health\"}[$__range])) > 0)",
          "refId": "G",
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": ""
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum by (method, controller, action) (increase(rails_db_runtime_seconds_sum{job=\"opj-api\",controller!=\"rails/health\"}[$__range])) / sum by (method, controller, action) (increase(rails_db_runtime_seconds_count{job=\"opj-api\",controller!=\"rails/health\"}[$__range]))) and on (method, controller, action) (sum by (method, controller, action) (increase(rails_requests_total{job=\"opj-api\",controller!=\"rails/health\"}[$__range])) > 0)",
          "refId": "H",
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": ""
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "method": 0,
              "controller": 1,
              "action": 2,
              "Value #A": 3,
              "Value #B": 4,
              "Value #C": 5,
              "Value #D": 6,
              "Value #E": 7,
              "Value #H": 8,
              "Value #F": 9,
              "Value #G": 10
            },
            "renameByName": {
              "Value #A": "Chamadas",
              "Value #B": "Média",
              "Value #C": "p50",
              "Value #D": "p95",
              "Value #E": "p99",
              "Value #F": "% 4xx",
              "Value #G": "% 5xx",
              "Value #H": "Tempo em banco (média)",
              "method": "Método",
              "controller": "Controller",
              "action": "Ação"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "p95",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
