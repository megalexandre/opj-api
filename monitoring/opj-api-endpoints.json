    },
    {
      "id": 2,
      "type": "bargauge",
      "title": "Mais lentas (p95)",
      "description": "Top 10 rotas com maior p95 no período (mínimo de 5 chamadas).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "topk(10, histogram_quantile(0.95, sum by (le, method, controller, action) (increase(rails_request_duration_seconds_bucket{job=\"opj-api\",controller!=\"rails/health\"}[$__range]))) and on (method, controller, action) (sum by (method, controller, action) (increase(rails_requests_total{job=\"opj-api\",controller!=\"rails/health\"}[$__range])) >= 5))",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "time_series",
          "legendFormat": "{{method}} {{controller}}#{{action}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1,
          "min": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.2
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
