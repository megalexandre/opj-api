          },
          "expr": "sum by (method, controller, action) (rate(rails_request_duration_seconds_sum{job=\"opj-api\",controller!=\"rails/health\"}[$__rate_interval])) / sum by (method, controller, action) (rate(rails_request_duration_seconds_count{job=\"opj-api\",controller!=\"rails/health\"}[$__rate_interval]))",
